# Скопируйте в .env и заполните. Лучше запустить ./scripts/setup.sh —
# он создаст .env со случайными ключами.
LITELLM_MASTER_KEY=sk-change-me
LITELLM_SALT_KEY=sk-change-me-too
POSTGRES_PASSWORD=litellm
LITELLM_PORT=4000

# Провайдеры (можно оставить пустыми и добавить ключи через LiteLLM UI).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
